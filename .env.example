# ------------------------------------------------------------------
# Formulario público de contacto (visitante -> vos). NO TOCAR si ya
# lo tenés funcionando en Vercel: sigue usando estas mismas variables.
# ------------------------------------------------------------------
SMTP_PROVIDER=gmail
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password
CONTACT_RECEIVER_EMAIL=tu_correo@gmail.com

# ------------------------------------------------------------------
# Panel admin: login (vos -> cualquier destinatario)
# ------------------------------------------------------------------
# Usuario y clave para entrar a /admin. Poné acá tu contraseña real.
ADMIN_USERNAME=Efrain
ADMIN_PASSWORD=cambia-esta-clave

# Clave para firmar la sesión del login. Generá una cadena larga y
# aleatoria (ej. con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esta-clave-tambien

# Cuentas emisoras disponibles en el panel admin. Podés agregar todas
# las que quieras: SMTP_ACCOUNT_1_*, SMTP_ACCOUNT_2_*, SMTP_ACCOUNT_3_*...
SMTP_ACCOUNT_1_LABEL=Gmail personal
SMTP_ACCOUNT_1_PROVIDER=gmail
SMTP_ACCOUNT_1_USER=tu_correo@gmail.com
SMTP_ACCOUNT_1_PASSWORD=tu_app_password

SMTP_ACCOUNT_2_LABEL=Gmail trabajo
SMTP_ACCOUNT_2_PROVIDER=gmail
SMTP_ACCOUNT_2_USER=tu_otro_correo@gmail.com
SMTP_ACCOUNT_2_PASSWORD=tu_app_password
# Nota: SMTP_ACCOUNT_N_* solo sirve para Gmail (u otro SMTP con usuario/clave).
# Outlook ya NO admite esto — usa la sección de Microsoft Graph más abajo.

# ------------------------------------------------------------------
# Outlook vía Microsoft Graph (OAuth2). Reemplaza al envío SMTP para
# cuentas de Outlook/Hotmail/Live, que Microsoft retiró en abril 2026.
# Los datos MS_CLIENT_ID / MS_CLIENT_SECRET salen de tu app registrada
# en Microsoft Entra ID (portal.azure.com o entra.microsoft.com).
# ------------------------------------------------------------------
MS_CLIENT_ID=tu-application-client-id
MS_CLIENT_SECRET=tu-client-secret
MS_TENANT=common
MS_REDIRECT_URI=https://tudominio.vercel.app/admin/outlook/callback

# La agrega sola Vercel al conectar la integración de Redis (Storage →
# Create Database → Redis). No hace falta que la escribas vos.
# REDIS_URL=redis://...

PORT=5000
FLASK_DEBUG=0
