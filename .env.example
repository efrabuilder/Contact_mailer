# Elegí "gmail", "outlook"/"hotmail", o dejalo vacío y poné SMTP_HOST/SMTP_PORT manualmente.
# Choose "gmail", "outlook"/"hotmail", or leave empty and set SMTP_HOST/SMTP_PORT manually.
SMTP_PROVIDER=gmail

# Solo necesarios si SMTP_PROVIDER está vacío (proveedor genérico).
# Only needed if SMTP_PROVIDER is empty (generic provider).
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587

# Cuenta que envía el correo. Con Gmail/Outlook usá una App Password, no tu contraseña normal.
# Account that sends the email. With Gmail/Outlook use an App Password, not your regular password.
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password

# A dónde llegan los mensajes del formulario. Si se omite, usa SMTP_USER.
# Where form messages are delivered. Defaults to SMTP_USER if omitted.
CONTACT_RECEIVER_EMAIL=tu_correo@gmail.com

PORT=5000
FLASK_DEBUG=0
